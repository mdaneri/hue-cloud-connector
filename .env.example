# Names only. This project does not load an env file or contact Hue.
HUE_MODE=mock
OWNER_SITE_USER_ID=REPLACE_AFTER_HOSTING_IS_APPROVED
# Future server-only runtime secrets, provisioned through a supported secure UI:
HUE_CLIENT_ID=PLACEHOLDER
HUE_CLIENT_SECRET=PLACEHOLDER
HUE_TOKEN_ENCRYPTION_KEY=PLACEHOLDER_32_RANDOM_BYTES
# Dedicated Hue callback; Sites reserves /callback for its own authentication.
HUE_REDIRECT_URI=https://connector.example.invalid/oauth/hue/callback
